# Supabase project URL and anon key (Project Settings -> API). Safe to expose — anon key
# is public by design, RLS/JWT verification does the actual authorization.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Base URL of apps/api (see apps/api/.env.example -> PORT). Server-only: the
# browser reaches the API through /api/proxy, never directly, so this can be an
# ngrok tunnel without ever being exposed. Set it in Vercel too.
API_URL="http://localhost:4000"

# Web push public key (pair of apps/api's VAPID_PRIVATE_KEY, same keypair).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
