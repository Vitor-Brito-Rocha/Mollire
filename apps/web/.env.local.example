# Supabase project URL and anon key (Project Settings -> API). Safe to expose — anon key
# is public by design, RLS/JWT verification does the actual authorization.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Base URL of apps/api (see apps/api/.env.example -> PORT). In production use the API's
# own subdomain (e.g. https://api.example.com) so it is same-site with the web app.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Parent domain the session cookie is shared on, so the browser also sends it to the
# API subdomain (web at app.example.com, API at api.example.com -> ".example.com").
# Server-only. Leave unset locally. Must NOT be a domain that also hosts users'
# published sites, or those pages could tamper with the cookie.
COOKIE_DOMAIN=""

# Web push public key (pair of apps/api's VAPID_PRIVATE_KEY, same keypair).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
