# Base URL of apps/api (see apps/api/.env.example -> PORT). The browser calls it
# directly, and auth (POST /auth/*) is handled by the API, which keeps the session
# in httpOnly cookies — this app holds no Supabase credentials or tokens.
# Changing it needs a rebuild/redeploy: NEXT_PUBLIC_* is baked in at build time.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Web push public key (pair of apps/api's VAPID_PRIVATE_KEY, same keypair).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
