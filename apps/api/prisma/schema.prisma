generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TENANT
}

enum DeploymentStatus {
  PENDING
  CLONING
  BUILDING
  PUBLISHING
  SUCCESS
  FAILED
}

enum ErrorSource {
  HTTP
  DEPLOY_PIPELINE
  UNCAUGHT
}

model User {
  id                      String   @id
  email                   String   @unique
  // The only identity shown publicly (gallery author, comments later). Derived
  // from the email at first sync, changeable via PATCH /users/me. Nullable only
  // so the migration is safe on existing rows — syncUser backfills it.
  handle                  String?  @unique
  role                    Role     @default(TENANT)
  xp                      Int      @default(0)
  // GitHub App installation ID — set when the user installs the App on their
  // GitHub account. Used to clone private repos and listen to push webhooks.
  github_installation_id  BigInt?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  projects           Project[]
  push_subscriptions PushSubscription[]
  admin_invites_sent AdminInvite[]
  project_stars      ProjectStar[]
  comments           Comment[]
  project_memberships      ProjectMember[]
  project_invitations_sent ProjectInvitation[] @relation("ProjectInvitationInviter")

  @@map("users")
}

// A pending grant of ADMIN role to an email that hasn't authenticated yet.
// Consumed (deleted) the moment that email's User row is provisioned or
// synced — see SupabaseAuthService.syncUser.
model AdminInvite {
  email      String   @id
  invited_by String
  created_at DateTime @default(now())

  invitedBy User @relation(fields: [invited_by], references: [id])

  @@map("admin_invites")
}

model Project {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  repository_url String
  build_command  String    @default("npm install && npm run build")
  output_dir     String    @default("dist")
  is_public      Boolean   @default(false)
  thumbnail_url  String?
  // Set once, the first time is_public turns true — never cleared again, even
  // if the project is later unpublished. Marks the one-time publish XP bonus
  // as already paid, so toggling public/private repeatedly can't farm it.
  published_at   DateTime?
  user_id        String
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  user        User         @relation(fields: [user_id], references: [id])
  deployments Deployment[]
  stars       ProjectStar[]
  comments    Comment[]
  members     ProjectMember[]
  invitations ProjectInvitation[]

  @@index([user_id])
  @@map("projects")
}

enum ProjectRole {
  OWNER
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// Who can see and deploy a project. The owner keeps Project.user_id (the
// unambiguous "whose is it"); members are additive. Every tenant-facing
// lookup goes through ProjectsService.findForMember, so membership — not
// ownership — is the boundary, and a mismatch is still 404.
model ProjectMember {
  id         String      @id @default(cuid())
  project_id String
  user_id    String
  role       ProjectRole @default(MEMBER)
  created_at DateTime    @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([project_id, user_id])
  @@index([user_id])
  @@map("project_members")
}

// Keyed by email, not user: the invitee may never have logged in (User rows
// are provisioned on first sync). Redeemed into a ProjectMember by
// MembersService.redeemInvitations, called from GET /users/me.
model ProjectInvitation {
  id          String           @id @default(cuid())
  project_id  String
  email       String
  role        ProjectRole      @default(MEMBER)
  status      InvitationStatus @default(PENDING)
  invited_by  String
  created_at  DateTime         @default(now())
  expires_at  DateTime
  accepted_at DateTime?

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  inviter User    @relation("ProjectInvitationInviter", fields: [invited_by], references: [id])

  @@unique([project_id, email])
  @@index([email, status])
  @@map("project_invitations")
}

// A comment on a published gallery project. Soft-deleted (deleted_at) by its
// author or an admin, so moderation removes it from view without losing the
// record.
model Comment {
  id         String    @id @default(cuid())
  project_id String
  user_id    String
  body       String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([project_id, created_at])
  @@map("comments")
}

// A tenant's gesture of appreciation for a published gallery project. Not
// itself a rating — one star per (project, viewer), no value beyond existing.
model ProjectStar {
  project_id String
  user_id    String
  created_at DateTime @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([project_id, user_id])
  @@map("project_stars")
}

model Deployment {
  id           String           @id @default(cuid())
  project_id   String
  status       DeploymentStatus @default(PENDING)
  commit_sha   String?
  release_path String?
  log          String?
  created_at   DateTime         @default(now())
  finished_at  DateTime?

  project Project @relation(fields: [project_id], references: [id])

  @@index([project_id])
  @@map("deployments")
}

model ErrorLog {
  id          String      @id @default(cuid())
  message     String
  stack       String?
  status_code Int?
  method      String?
  path        String?
  source      ErrorSource
  user_id     String?
  created_at  DateTime    @default(now())

  @@index([created_at])
  @@map("error_logs")
}

model PushSubscription {
  id         String   @id @default(cuid())
  user_id    String
  endpoint   String   @unique
  p256dh     String
  auth       String
  user_agent String?
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("push_subscriptions")
}
