generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TENANT
}

enum DeploymentStatus {
  QUEUED
  PENDING
  CLONING
  BUILDING
  PUBLISHING
  SUCCESS
  FAILED
}

enum ErrorSource {
  HTTP
  DEPLOY_PIPELINE
  UNCAUGHT
}

// Why XP was paid. The codes are the contract with the frontend catalog
// (modules/progress/lib/catalog.ts) — add here, then there.
enum XpReason {
  DEPLOY
  FIRST_DEPLOY
  PUBLISH
  STAR_RECEIVED
  QUEST
  ACHIEVEMENT
  HELPFUL_COMMENT
}

model User {
  id         String   @id
  email      String   @unique
  // The only identity shown publicly (gallery author, comments later). Derived
  // from the email at first sync, changeable via PATCH /users/me. Nullable only
  // so the migration is safe on existing rows — syncUser backfills it.
  handle     String?  @unique
  // Cosmetic: which level-badge frame the user chose (see common/frames.ts).
  // Null = the default frame. Public, like the level itself.
  frame      String?
  role       Role     @default(TENANT)
  xp         Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  projects                 Project[]
  push_subscriptions       PushSubscription[]
  admin_invites_sent       AdminInvite[]
  project_stars            ProjectStar[]
  comments                 Comment[]
  project_memberships      ProjectMember[]
  project_invitations_sent ProjectInvitation[] @relation("ProjectInvitationInviter")
  github_accounts          GithubAccount[]
  xp_events                XpEvent[]
  quest_completions        QuestCompletion[]
  achievements             Achievement[]
  turmas_owned             Turma[]
  turma_memberships        TurmaMember[]

  @@map("users")
}

// A personal milestone the user has unlocked. Same idea as QuestCompletion: the
// row pays its XP once and is never removed, even if what earned it is undone.
// The catalog (what exists, how it's earned) lives in progress/achievements.catalog.ts.
model Achievement {
  user_id     String
  code        String
  unlocked_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, code])
  @@map("achievements")
}

// A first-steps quest the user has finished. The row is what pays the XP once:
// it outlives whatever completed the quest (disconnecting GitHub, deleting the
// project), so undoing and redoing can't earn it twice. Which quests exist, and
// what each is worth, lives in code (progress/quests.catalog.ts).
model QuestCompletion {
  user_id      String
  code         String
  completed_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, code])
  @@map("quest_completions")
}

// One row per XP payment. User.xp is a cache of the sum of these (for users
// that earned XP after this table existed) — xp.award writes both in one
// transaction. project_id / actor_id are plain ids, not relations: history
// outlives a deleted project, and the API resolves them to slug/handle on read.
model XpEvent {
  id         String   @id @default(uuid())
  user_id    String
  amount     Int
  reason     XpReason
  project_id String? // deploy, publish, star received
  actor_id   String? // who starred / whose comment it was
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("xp_events")
}

// A GitHub account (personal or organization) connected via the GitHub App.
// One Mollire user can have multiple GitHub accounts installed.
model GithubAccount {
  id                   String   @id @default(cuid())
  installation_id      BigInt   @unique
  account_login        String
  account_id           BigInt
  account_avatar_url   String
  account_type         String // "User" | "Organization"
  repository_selection String // "all" | "selected"
  user_id              String
  created_at           DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("github_accounts")
}

// A pending grant of ADMIN role to an email that hasn't authenticated yet.
// Consumed (deleted) the moment that email's User row is provisioned or
// synced — see SupabaseAuthService.syncUser.
model AdminInvite {
  email      String   @id
  invited_by String
  created_at DateTime @default(now())

  invitedBy User @relation(fields: [invited_by], references: [id])

  @@map("admin_invites")
}

model Project {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  repository_url String
  // Folder of the repo where install + build run; "" is the repo root.
  root_dir       String    @default("")
  // Just the build: the platform runs `npm install` before it, always.
  build_command  String    @default("npm run build")
  // Relative to root_dir.
  output_dir     String    @default("dist")
  is_public      Boolean   @default(false)
  thumbnail_url  String?
  // Set once, the first time is_public turns true — never cleared again, even
  // if the project is later unpublished. Marks the one-time publish XP bonus
  // as already paid, so toggling public/private repeatedly can't farm it.
  published_at   DateTime?
  user_id        String
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  // Classroom submission: which turma (and, inside it, which group) this
  // project was handed in for. Both null until a member submits it via
  // POST /turmas/:id/projects — independent from is_public, so a project
  // can be graded inside a private turma without ever hitting the gallery.
  turma_id       String?
  turma_group_id String?
  // Set by the turma's professor only (TurmasService.gradeProject). Cleared
  // whenever the project is resubmitted or removed from the turma.
  grade          Float?
  graded_at      DateTime?
  graded_by      String?

  user        User                @relation(fields: [user_id], references: [id])
  deployments Deployment[]
  stars       ProjectStar[]
  comments    Comment[]
  members     ProjectMember[]
  invitations ProjectInvitation[]
  env_vars    ProjectEnvVar[]
  views       ProjectView[]
  activities  ProjectActivity[]
  site_checks SiteCheck[]
  turma       Turma?              @relation(fields: [turma_id], references: [id], onDelete: SetNull)
  turmaGroup  TurmaGroup?         @relation(fields: [turma_group_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([turma_id])
  @@index([turma_group_id])
  @@map("projects")
}

// Build-time environment variables for a project. Values are encrypted at rest
// (AES-256-GCM via ENV_ENCRYPTION_KEY) and never returned by the API after
// creation — only keys are exposed, matching the GitHub Secrets model.
model ProjectEnvVar {
  id         String   @id @default(cuid())
  project_id String
  key        String
  value      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, key])
  @@index([project_id])
  @@map("project_env_vars")
}

enum ProjectRole {
  OWNER
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// Who can see and deploy a project. The owner keeps Project.user_id (the
// unambiguous "whose is it"); members are additive. Every tenant-facing
// lookup goes through ProjectsService.findForMember, so membership — not
// ownership — is the boundary, and a mismatch is still 404.
model ProjectMember {
  id         String      @id @default(cuid())
  project_id String
  user_id    String
  role       ProjectRole @default(MEMBER)
  created_at DateTime    @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([project_id, user_id])
  @@index([user_id])
  @@map("project_members")
}

// Keyed by email, not user: the invitee may never have logged in (User rows
// are provisioned on first sync). Redeemed into a ProjectMember by
// MembersService.redeemInvitations, called from GET /users/me.
model ProjectInvitation {
  id          String           @id @default(cuid())
  project_id  String
  email       String
  role        ProjectRole      @default(MEMBER)
  status      InvitationStatus @default(PENDING)
  invited_by  String
  created_at  DateTime         @default(now())
  expires_at  DateTime
  accepted_at DateTime?

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  inviter User    @relation("ProjectInvitationInviter", fields: [invited_by], references: [id])

  @@unique([project_id, email])
  @@index([email, status])
  @@map("project_invitations")
}

// A comment on a published gallery project. Soft-deleted (deleted_at) by its
// author or an admin, so moderation removes it from view without losing the
// record.
model Comment {
  id              String    @id @default(cuid())
  project_id      String
  user_id         String
  body            String
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?
  // The project owner flagged this comment as helpful (null = not, or un-flagged).
  helpful_at      DateTime?
  // Set the first time it was flagged and never cleared: the one-time XP for the
  // author is paid off this, so un-flagging and re-flagging can't pay twice.
  helpful_paid_at DateTime?

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([project_id, created_at])
  @@map("comments")
}

// A tenant's gesture of appreciation for a published gallery project. Not
// itself a rating — one star per (project, viewer), no value beyond existing.
model ProjectStar {
  project_id String
  user_id    String
  created_at DateTime @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([project_id, user_id])
  @@map("project_stars")
}

model Deployment {
  id             String           @id @default(cuid())
  project_id     String
  status         DeploymentStatus @default(PENDING)
  commit_sha     String?
  commit_message String?
  release_path   String?
  // True when this deploy re-published an earlier successful commit instead of
  // the newest one (POST /projects/:slug/deploy with commit_sha). Feeds the
  // "rollback" achievement.
  is_rollback    Boolean          @default(false)
  log            String?
  created_at     DateTime         @default(now())
  finished_at    DateTime?

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@map("deployments")
}

model ErrorLog {
  id          String      @id @default(cuid())
  message     String
  stack       String?
  status_code Int?
  method      String?
  path        String?
  source      ErrorSource
  user_id     String?
  created_at  DateTime    @default(now())

  @@index([created_at])
  @@map("error_logs")
}

// One reachability probe of a published project's site (UptimeService). The
// current "up since" is derived from these: the start of the unbroken run of ok
// checks that ends at the latest one. Old rows are pruned; a project's checks
// are cleared when it leaves the gallery, so the run restarts on republish.
model SiteCheck {
  id         String   @id @default(cuid())
  project_id String
  ok         Boolean
  checked_at DateTime @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, checked_at])
  @@map("site_checks")
}

model ProjectView {
  id         String   @id @default(cuid())
  project_id String
  visitor_id String
  country    String?
  path       String   @default("/")
  date       DateTime @db.Date

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, visitor_id, path, date])
  @@index([project_id, date])
  @@map("project_views")
}

enum ActivityType {
  DEPLOY_TRIGGERED
  DEPLOY_SUCCESS
  DEPLOY_FAILED
  MEMBER_ADDED
  MEMBER_REMOVED
  STAR_RECEIVED
  COMMENT_ADDED
  VISIBILITY_CHANGED
  ACHIEVEMENT_UNLOCKED
}

model ProjectActivity {
  id         String       @id @default(cuid())
  project_id String
  type       ActivityType
  actor_id   String?
  payload    Json?
  created_at DateTime     @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, created_at])
  @@map("project_activities")
}

model PushSubscription {
  id         String   @id @default(cuid())
  user_id    String
  endpoint   String   @unique
  p256dh     String
  auth       String
  user_agent String?
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("push_subscriptions")
}

enum TurmaRole {
  PROFESSOR
  ALUNO
}

// NONE: no groups, every submission is individual. GROUPS: the professor
// defines fixed-size groups (TurmaGroup) that students join after entering
// the turma.
enum TurmaGroupMode {
  NONE
  GROUPS
}

// A classroom. Any member can create one — the creator becomes its
// TurmaMember with role PROFESSOR (checked in code, not by a global Role,
// since the same user is a plain TENANT everywhere else in the product).
// Name is only unique per-owner (@@unique([owner_id, name])): two different
// professors, or the same professor across terms, can reuse "Turma 1".
model Turma {
  id          String         @id @default(cuid())
  name        String
  // Join code — always generated, used by private turmas as the only way in
  // and offered to public ones too as a shortcut. See TurmasService.generateCode.
  code        String         @unique
  description String?
  // Public: listed for anyone to browse and join. Private: joinable only by code.
  is_public   Boolean        @default(false)
  // Max number of ALUNO members; null = unlimited. Never counts the professor.
  capacity    Int?
  group_mode  TurmaGroupMode @default(NONE)
  owner_id    String
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt

  owner    User          @relation(fields: [owner_id], references: [id])
  members  TurmaMember[]
  groups   TurmaGroup[]
  projects Project[]

  @@unique([owner_id, name])
  @@index([owner_id])
  @@map("turmas")
}

// A group within a turma, sized by the professor (max_size). Students join
// one after entering the turma; only meaningful when Turma.group_mode is
// GROUPS.
model TurmaGroup {
  id         String   @id @default(cuid())
  turma_id   String
  name       String
  max_size   Int
  created_at DateTime @default(now())

  turma    Turma         @relation(fields: [turma_id], references: [id], onDelete: Cascade)
  members  TurmaMember[]
  projects Project[]

  @@unique([turma_id, name])
  @@index([turma_id])
  @@map("turma_groups")
}

// Membership is the boundary for a turma, exactly like ProjectMember is for
// a project: every tenant-facing lookup goes through
// TurmasService.findForMember, so a turma you're not in doesn't exist for
// you — 404, never 403.
model TurmaMember {
  id        String    @id @default(cuid())
  turma_id  String
  user_id   String
  role      TurmaRole @default(ALUNO)
  group_id  String?
  joined_at DateTime  @default(now())

  turma Turma       @relation(fields: [turma_id], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  group TurmaGroup? @relation(fields: [group_id], references: [id], onDelete: SetNull)

  @@unique([turma_id, user_id])
  @@index([turma_id])
  @@index([group_id])
  @@map("turma_members")
}
