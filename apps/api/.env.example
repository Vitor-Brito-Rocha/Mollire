PORT=4000

# Supabase Postgres connection string (direct connection, not the pgbouncer pooler port —
# this service is a long-running process, not serverless).
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Root domain projects are published under: {slug}.DOMAIN
DOMAIN=aulvi.com.br

# Where cloned repos and built releases are stored.
# Point this at /var/www/projects in production; a local folder is fine for dev.
PROJECTS_ROOT=./data/projects

# Where gallery thumbnails (captured via Playwright after a successful deploy
# of a public project) are saved and served from (GET /thumbnails/{slug}.png).
THUMBNAILS_DIR=./data/thumbnails

# Supabase project URL (Project Settings -> API -> Project URL). Used to fetch the
# project's JWKS at {SUPABASE_PROJECT_URL}/auth/v1/.well-known/jwks.json for verifying
# access tokens issued to the frontend — this project uses asymmetric (ES256) signing
# keys, not the legacy shared HS256 secret, so no separate JWT secret is needed here.
SUPABASE_PROJECT_URL="https://[PROJECT-REF].supabase.co"

# Web push (generate once with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:vitor.britorocha2019@gmail.com"

# Supabase anon key (Project Settings -> API). The API logs users in / out and refreshes
# their session itself (POST /auth/*), so the session can live in httpOnly cookies.
SUPABASE_ANON_KEY=""

# Origins of the dashboard allowed to call this API (CORS, with credentials — the
# session is an httpOnly cookie). Exact origins, comma-separated, no wildcard;
# /auth/* and cookie-authenticated writes from any other Origin get a 403. Leave
# empty and every browser call is blocked.
FRONTEND_URL="http://localhost:3000,https://mollire.vercel.app"

# Docker build sandbox — each deploy runs in an isolated container.
# Requires Docker to be installed and running on the host.
BUILD_DOCKER_IMAGE=node:20-alpine
BUILD_MEMORY_LIMIT=512m
BUILD_CPU_LIMIT=0.5
BUILD_PIDS_LIMIT=100
BUILD_TIMEOUT_MS=300000

# Session cookie mode — see docs/pendencias.md.
# true  = web and API on DIFFERENT sites (web on vercel.app, API via an ngrok tunnel):
#         SameSite=None; Secure; Partitioned. Temporary; does not work in Safari.
# false = web and API on the same site (sibling subdomains, or both localhost): normal
#         SameSite=Lax cookie. Set COOKIE_DOMAIN=.example.com for sibling subdomains.
COOKIE_CROSS_SITE=false
COOKIE_DOMAIN=""
