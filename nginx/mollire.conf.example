# One server block for every project — creating a project never touches Nginx config.
# Deploys just write files to disk; this block resolves the slug from the Host header
# and serves whatever `current` currently symlinks to.
#
# Install: copy to /etc/nginx/sites-available/mollire.conf, symlink into sites-enabled,
# point PROJECTS_ROOT (in .env) at the same path as `root` below, then `nginx -s reload`
# once. After that, no further reloads are needed per project or per deploy.

server {
    listen 80;
    server_name *.aulvi.com.br;

    set $slug "";
    if ($host ~* "^([a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)\.aulvi\.com\.br$") {
        set $slug $1;
    }

    if ($slug = "") {
        return 404;
    }

    root /var/www/projects/$slug/current;
    index index.html;

    # Sub-requisição interna de auth_request — inacessível diretamente pelo browser.
    location = /_internal_auth {
        internal;
        proxy_pass http://127.0.0.1:4000/internal/auth?slug=$slug;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Original-URI $request_uri;
    }

    location / {
        auth_request /_internal_auth;
        error_page 401 = @login;
        error_page 403 = @forbidden;
        try_files $uri $uri/ /index.html;
    }

    location @login {
        return 302 https://app.aulvi.com.br/login?next=$scheme://$host$request_uri;
    }

    location @forbidden {
        root /var/www/mollire-public;
        try_files /forbidden.html =403;
    }
}
